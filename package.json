{
  "dependencies": {
    "@slack/web-api": "^8.2.0",
    "@slack/webhook": "^8.0.2",
    "commander": "^15.0.0",
    "https-proxy-agent": "^7.0.6",
    "undici": "^8.11.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@slack/types": "^3.0.0",
    "@types/bun": "1.4.2",
    "@types/node": ">=26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.71.1",
    "dotenv": "^18.0.6",
    "eslint": "^10.12.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-instrument": "6.0.3",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "prettier": "^3.9.9",
    "ts-sinon": "^2.0.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "scripts": {
    "test": "bun test",
    "test:coverage": "bun scripts/coverage.ts",
    "pw": "bun run test:coverage",
    "harness": "bun harness/run.mjs",
    "harness:offline": "bun harness/run.mjs --offline",
    "prettier": "bun --bun x prettier --write --log-level warn \"**/**/*.ts\"",
    "build": "bun scripts/build.ts",
    "typecheck": "bun --bun x tsc --noEmit --noErrorTruncation --pretty false --incremental false -p tsconfig.json",
    "lint": "bun --bun x eslint src",
    "lint:fix": "bun --bun x eslint src --fix",
    "cli": "bun run build && bun dist/cli.js",
    "cli-debug": "bun run cli -- -c ./cli_config.json -j ./tests/test_data/valid_test_results.json"
  },
  "name": "playwright-slack-report",
  "version": "1.1.116",
  "bin": {
    "playwright-slack-report": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanrosello-og/playwright-slack-report.git"
  },
  "author": "Ryan Rosello <ryanrosello@hotmail.com>",
  "license": "MIT",
  "files": [
    "/dist/src",
    "/dist/cli.js"
  ],
  "resolutions": {
    "axios": "^1.17.0"
  },
  "keywords": [
    "slack",
    "report",
    "playwright",
    "typescript"
  ],
  "packageManager": "bun@1.4.3"
}
