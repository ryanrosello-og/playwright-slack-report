{
  "exclude": ["node_modules", "dist", "harness", "website"],
  "compilerOptions": {
      "target": "ESNext",
      "module": "preserve",
      "moduleResolution": "bundler",
      "sourceMap": true,
      "outDir": "./dist",
      "declaration": true,
      "resolveJsonModule": true,
      "esModuleInterop": true,
  }
}
